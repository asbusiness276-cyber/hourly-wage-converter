{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": "www.hourlywageconverter.com" }], "destination": "https://hourlywageconverter.com/$1", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/calculators/hourly-to-salary/", "destination": "/hourly-to-salary-calculator/", "permanent": true },
    { "source": "/calculators/salary-to-hourly/", "destination": "/salary-to-hourly-calculator/", "permanent": true },
    { "source": "/calculators/overtime/", "destination": "/overtime-calculator/", "permanent": true },
    { "source": "/calculators/paycheck/", "destination": "/paycheck-calculator/", "permanent": true },
    { "source": "/faq/", "destination": "/faqs/", "permanent": true },
    { "source": "/faq", "destination": "/faqs/", "permanent": true },
    { "source": "/faqs.html", "destination": "/faqs/", "permanent": true },
    { "source": "/faq.html", "destination": "/faqs/", "permanent": true },
    { "source": "/privacy.html", "destination": "/privacy-policy/", "permanent": true },
    { "source": "/terms.html", "destination": "/terms/", "permanent": true },
    { "source": "/contact.html", "destination": "/contact/", "permanent": true },
    { "source": "/blog.html", "destination": "/articles/", "permanent": true },
    { "source": "/blog", "destination": "/articles/", "permanent": true },
    { "source": "/blog/", "destination": "/articles/", "permanent": true },
    { "source": "/author", "destination": "/author/saahil/", "permanent": true },
    { "source": "/author/", "destination": "/author/saahil/", "permanent": true },
    { "source": "/articles/how-to-calculate-hourly-wage-to-salary/", "destination": "/articles/how-to-convert-hourly-pay-to-annual-salary/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)\\.(png|jpg|jpeg|gif|svg|ico|webp)$",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)\\.(css|js)$",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
